# Competitive Intelligence Dashboard - Environment Variables
#
# Copy this file to .env for local development:
# cp .env.example .env
#
# For Vercel deployment, add these variables in the Vercel dashboard
# or using the Vercel CLI: vercel env add API_KEY

# API Ninjas API Key
# Get your free API key at: https://api-ninjas.com/
# This key is used to fetch real-time stock price data
API_KEY=your_api_ninjas_key_here
